---
import type { PortfolioItem } from '../domain/portfolio/types';
import TechnologyGroups from './TechnologyGroups.astro';

interface Props {
  projects: PortfolioItem[];
  detailBasePath: string;
  labels?: {
    challenge: string;
    solution: string;
    impact: string;
    repository: string;
    details: string;
    supportedTechnologies: string;
  };
}

const { projects, detailBasePath, labels } = Astro.props;
const text = labels ?? {
  challenge: 'Challenge',
  solution: 'Solution',
  impact: 'Impact',
  repository: 'Repository',
  details: 'Details',
  supportedTechnologies: 'Supported technologies'
};

const toBase = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
  const cleanPath = path.replace(/^\/+/, '');
  return `${base}/${cleanPath}`.replace(/\/{2,}/g, '/');
};
---

<div class="accordion-list">
  {
    projects.map((project) => (
      <details class="accordion-item">
        <summary>
          <span class="accordion-title">{project.title}</span>
          <span class="accordion-arrow" aria-hidden="true">▾</span>
        </summary>
        <div class="accordion-body">
          <p><strong>{text.challenge}:</strong> {project.challenge}</p>
          <p><strong>{text.solution}:</strong> {project.solution}</p>
          <p><strong>{text.impact}:</strong> {project.impact}</p>
          <TechnologyGroups technologies={project.technologies} language={project.language} />
          {project.supportedTechnologies?.length ? (
            <div class="supported-technologies">
              <span class="supported-technologies-label">{text.supportedTechnologies}</span>
              <ul aria-label={text.supportedTechnologies}>
                {project.supportedTechnologies.map((technology) => <li>{technology}</li>)}
              </ul>
            </div>
          ) : null}
          <div class="accordion-links">
            <a class="cta" href={toBase(`${detailBasePath}/${project.slug}`)}>{text.details} →</a>
            <a class="cta" href={project.repo} target="_blank" rel="noreferrer">{text.repository} ↗</a>
          </div>
        </div>
      </details>
    ))
  }
</div>
